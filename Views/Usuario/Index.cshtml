@model IEnumerable<GomezZuñigaAntonio.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email_usu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pass_usu)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Email_usu)
            </td>
            <td>
                @Html.DisplayFor(model => item.Pass_usu)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id_usu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id_usu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id_usu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
